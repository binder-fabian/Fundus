# Fundus – Konfiguration über Umgebungsvariablen.
# Kopieren nach .env und Werte anpassen: cp .env.example .env

# Pflicht: langer, zufälliger Wert. Erzeugen z. B. mit:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Adresse, unter der Fundus erreichbar ist (ohne https://), mehrere mit Komma.
ALLOWED_HOSTS=fundus.meine-schule.de,localhost
# Gleiche Adresse mit Schema, nötig für Formulare hinter dem Reverse Proxy.
CSRF_TRUSTED_ORIGINS=https://fundus.meine-schule.de
# 1, wenn Fundus hinter einem Reverse Proxy mit HTTPS läuft (empfohlen, für den Kamera-Scanner nötig).
BEHIND_HTTPS_PROXY=1

# Öffentliche Adresse mit https://, wird für Links in E-Mails (Einladungen) verwendet.
SITE_URL=https://fundus.meine-schule.de

# Passwort für die PostgreSQL-Datenbank aus docker-compose.yml.
POSTGRES_PASSWORD=

# Datenbank. docker-compose.yml setzt das selbst; nur bei nativer Installation nötig.
# PostgreSQL: postgres://fundus:PASSWORT@localhost:5432/fundus
# SQLite:     sqlite:////var/lib/fundus/fundus.sqlite3
# DATABASE_URL=

# E-Mail-Versand (Einladungen, Erinnerungen).
# Beispiel: smtp+tls://benutzer:passwort@smtp.meine-schule.de:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=fundus@meine-schule.de

# Optional: API-Schlüssel für Google Books als dritte Quelle beim ISBN-Abruf.
# GOOGLE_BOOKS_API_KEY=

# Uhrzeit (Stunde), ab der täglich die Erinnerungen verschickt werden.
REMINDER_HOUR=7

# Port, auf dem Fundus auf dem Server lauscht (docker-compose.yml).
FUNDUS_PORT=8000

# Nur für Entwicklung: 1 schaltet Fehlerseiten mit Details ein. Im Betrieb immer 0.
DEBUG=0
